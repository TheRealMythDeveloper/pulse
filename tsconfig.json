
{
  "name": "pulse",
  "displayName": "Pulse",
  "description": "Privacy-conscious AI development activity tracker",
  "version": "0.1.0",
  "publisher": "mythos-studios",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/extension.js",
  "activationEvents": [
    "onCommand:pulse.openDashboard"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pulse.openDashboard",
        "title": "Pulse: Open Dashboard"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "pulse.openDashboard"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0"
  }
}
